# Copy to .env locally. NEVER commit real secrets.
APP_ENV=development
APP_NAME=AURA
APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
SECRET_KEY=replace_with_a_long_random_secret
DATABASE_URL=postgresql+psycopg://aura:aura@localhost:5432/aura
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# AI providers are optional. Add keys only after selecting a provider.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Safety defaults
ALLOW_PAID_PROVIDER_USAGE=false
GLOBAL_DAILY_SPEND_LIMIT=0
DEFAULT_USER_DAILY_REQUEST_LIMIT=20
MAX_UPLOAD_MB=20
MAX_CONCURRENT_JOBS_PER_USER=2
