# Copy to backend/.env for local development. NEVER commit real secrets.
APP_ENV=development
APP_URL=http://localhost:5173
SECRET_KEY=replace_with_a_long_random_secret
DATABASE_URL=postgresql+psycopg://aura:aura@127.0.0.1:5433/aura
CORS_ORIGINS=["http://localhost:5173"]

# Email (optional in development; verification links go to the outbox table instead)
RESEND_API_KEY=
MAIL_FROM=
BOOTSTRAP_ADMIN_EMAIL=

# AI providers are optional and free-tier only by default. Add keys only after accepting provider terms.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Safety defaults (paid usage stays disabled unless the owner explicitly enables it)
ALLOW_PAID_PROVIDER_USAGE=false
GLOBAL_DAILY_SPEND_LIMIT=0
DEFAULT_USER_DAILY_REQUEST_LIMIT=20
MAX_UPLOAD_MB=20
MAX_CONCURRENT_JOBS_PER_USER=2
